==================================================*/


/*==================================================
GLOBAL
==================================================*/

QMainWindow{

    background:#17181C;

    color:#F5F5F5;

    font-family:"Segoe UI Variable","Segoe UI";

    font-size:10pt;

}


/*==================================================
CARD
==================================================*/

QFrame{

    background:#23252B;

    border:1px solid #33363D;

    border-radius:16px;

}


/*==================================================
LABEL
==================================================*/

QLabel{

    color:#F5F5F5;

    background:transparent;

}

QLabel#Title{

    font-size:24pt;

    font-weight:700;

}

QLabel#Subtitle{

    color:#A1A1AA;

}

QLabel#Status{

    color:#22C55E;

    font-weight:600;

}


/*==================================================
LINE EDIT
==================================================*/

QLineEdit{

    background:#1E2025;

    color:white;

    border:1px solid #3A3D45;

    border-radius:12px;

    padding:10px;

    selection-background-color:#2563EB;

}

QLineEdit:focus{

    border:2px solid #2563EB;

}


/*==================================================
BUTTON
==================================================*/

QPushButton{

    background:#2563EB;

    color:white;

    border:none;

    border-radius:12px;

    padding:12px 22px;

    font-size:10pt;

    font-weight:600;

    min-height:42px;

}

QPushButton:hover{

    background:#3B82F6;

}

QPushButton:pressed{

    background:#1D4ED8;

}

QPushButton:disabled{

    background:#3B3B3B;

    color:#888888;

}


/*==================================================
TEXT EDIT
==================================================*/

QTextEdit{

    background:#141518;

    color:#E5E7EB;

    border:1px solid #30323A;

    border-radius:12px;

    padding:10px;

    font-family:"Consolas";

    font-size:10pt;

}


/*==================================================
PROGRESS BAR
==================================================*/

QProgressBar{

    background:#30323A;

    border:none;

    border-radius:8px;

    text-align:center;

    color:white;

    height:18px;

}

QProgressBar::chunk{

    background:#2563EB;

    border-radius:8px;

}


/*==================================================
MENU BAR
==================================================*/

QMenuBar{

    background:#1B1D22;

    color:white;

}

QMenuBar::item{

    padding:8px 14px;

    background:transparent;

}

QMenuBar::item:selected{

    background:#2563EB;

    border-radius:6px;

}


/*==================================================
MENU
==================================================*/

QMenu{

    background:#1F2025;

    color:white;

    border:1px solid #3A3A40;

}

QMenu::item{

    padding:8px 28px;

}

QMenu::item:selected{

    background:#2563EB;

}


/*==================================================
STATUS BAR
==================================================*/

QStatusBar{

    background:#1B1D22;

    color:#A1A1AA;

    border-top:1px solid #2D2F36;

}


/*==================================================
SCROLLBAR
==================================================*/

QScrollBar:vertical{

    background:#1E1F24;

    width:10px;

    border:none;

}

QScrollBar::handle:vertical{

    background:#4B5563;

    border-radius:5px;

}

QScrollBar::handle:vertical:hover{

    background:#6B7280;

}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical{

    height:0px;

}


/*==================================================
TOOLTIP
==================================================*/

QToolTip{

    background:#2563EB;

    color:white;

    border:none;

    padding:6px;

}


/*==================================================
MESSAGE BOX
==================================================*/

QMessageBox{

    background:#23252B;

}

QMessageBox QLabel{

    color:white;

}

QMessageBox QPushButton{

    min-width:90px;

}