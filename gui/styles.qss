/* ==========================
   WINDOW
========================== */

QMainWindow{

    background:#17181C;

}


/* ==========================
   CARD
========================== */

QFrame#Card{

    background:#FFFFFF;

    border:1px solid #E5E7EB;

    border-radius:16px;

}

QFrame#Card:hover{

    border:1px solid #CBD5E1;

}


/* ==========================
   LABEL
========================== */

QLabel{

    color:#F3F4F6;

    background:transparent;

}


/* ==========================
   LINE EDIT
========================== */

QLineEdit{

    background:#1E2025;

    border:1px solid #3A3D45;

    border-radius:12px;

    padding:10px;

    color:white;

    selection-background-color:#2563EB;

    font-size:11pt;

}

QLineEdit:focus{

    border:2px solid #2563EB;

}


/* ==========================
   BUTTON
========================== */

QPushButton{

    background:#2563EB;

    color:white;

    border:none;

    border-radius:12px;

    padding:10px 18px;

    font-size:11pt;

    font-weight:600;

    min-height:42px;

}

QPushButton:hover{

    background:#3B82F6;

}

QPushButton:pressed{

    background:#1D4ED8;

}

QPushButton:disabled{

    background:#3C3F46;

    color:#808080;

}


/* ==========================
   PROGRESS BAR
========================== */

QProgressBar{

    border:none;

    background:#E5E7EB;

    border-radius:9px;

    min-height:18px;

}

QProgressBar::chunk{

    background:qlineargradient(
        x1:0,y1:0,x2:1,y2:0,
        stop:0 #22C55E,
        stop:1 #16A34A
    );

    border-radius:9px;

}


/* ==========================
   TEXT EDIT
========================== */

QTextEdit{

    background:#141518;

    border:1px solid #30323A;

    border-radius:12px;

    color:#E5E7EB;

    padding:10px;

    font-family:"Consolas";

    font-size:10pt;

}


/* ==========================
   STATUS BAR
========================== */

QStatusBar{

    background:#1D1F24;

    color:#A1A1AA;

    border-top:1px solid #343740;

}


/* ==========================
   SCROLL BAR
========================== */

QScrollBar:vertical{

    width:10px;

    background:#1A1B1F;

    border:none;

}

QScrollBar::handle:vertical{

    background:#555A66;

    border-radius:5px;

}

QScrollBar::handle:vertical:hover{

    background:#6B7280;

}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical{

    height:0px;

}


/* ==========================
   TOOLTIP
========================== */

QToolTip{

    background:#2563EB;

    color:white;

    border:none;

    padding:6px;

}

QLabel#HeaderTitle{

    font-size:28px;

    font-weight:700;

    color:#111827;

}

QLabel#HeaderSubtitle{

    font-size:13px;

    color:#6B7280;

}

QLabel#HeaderAuthor{

    font-size:11px;

    color:#9CA3AF;

}

QLabel#HeaderReady{

    color:#16A34A;

    font-size:13px;

    font-weight:bold;

}

QLabel#HeaderVersion{

    color:#9CA3AF;

    font-size:11px;

}

QLabel#CardTitle{

    font-size:18px;

    font-weight:700;

    color:#111827;

}

QLabel#CardSubtitle{

    font-size:12px;

    color:#6B7280;

    margin-bottom:6px;

}

QLineEdit{

    background:#F8FAFC;

    border:1px solid #CBD5E1;

    border-radius:12px;

    padding:12px 16px;

    color:#111827;

    font-size:12pt;

}

QLineEdit:focus{

    border:2px solid #2563EB;

    background:white;

}

QPushButton{

    background:#2563EB;

    color:white;

    border:none;

    border-radius:12px;

    font-size:11pt;

    font-weight:bold;

    padding:10px 18px;

}

QPushButton:hover{

    background:#1D4ED8;

}

QLabel#InfoLabel{

    color:#64748B;

    font-size:11pt;

    font-weight:600;

}

QLabel#InfoValue{

    color:#111827;

    font-size:11pt;

    font-weight:700;

}

QTextEdit#LogConsole{

    background:#0F172A;

    color:white;

    border:none;

    border-radius:14px;

    padding:12px;

    font-family:Consolas;

    font-size:11pt;

}

QLabel#Thumbnail{

    background:#F8FAFC;

    border:1px solid #CBD5E1;

    border-radius:14px;

    color:#94A3B8;

    font-size:16px;

    font-weight:bold;

}